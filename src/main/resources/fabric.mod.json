{
  "schemaVersion": 1,
  "id": "mipmaps",
  "version": "${version}",

  "name": "Mipmaps",
  "description": "Adds mipmaps to stationapi",
  "authors": [
    "Ralf2oo2"
  ],

  "license": "MIT",
  "icon": "assets/mipmaps/icon.png",

  "environment": "client",
  "entrypoints": {
    "stationapi:event_bus": [
    ],
    "stationapi:event_bus_client": [
    ],
    "stationapi:event_bus_server": [
    ],
    "gcapi3": [
      "net.ralf2oo2.mipmaps.config.Config"
    ],
    "gcapi3:factory_provider": [
      "net.ralf2oo2.mipmaps.config.ConfigFactories"
    ],
    "gcapi3:presave": [
      "net.ralf2oo2.mipmaps.config.ConfigChangedListener"
    ]
  },
  "mixins": [
    "mipmaps.mixins.json"
  ],

  "depends": {
    "minecraft": "1.0.0-beta.7.3"
  }
}
